# ---- PRTS 干员数据爬虫配置 ----
# 复制本文件为 .env 后按需修改；真实环境变量优先级高于此文件。
# 变量清单见 README「配置（.env）」一节。

# 写进 User-Agent 的联系方式：站点出问题时别人能找到你
PRTS_USER_AGENT=prts-crawler/0.1 (personal use; contact: you@example.com)

# 每秒请求数上限。请勿调高：全量一轮已经约 460 次请求
PRTS_RATE=4
# 并发批次数（同屏并行请求的批数，不是并发连接数）
PRTS_WORKERS=4
# 单请求超时（秒）与失败重试次数
PRTS_TIMEOUT=30
PRTS_RETRIES=5

# 输出目录（相对路径基于当前工作目录）
PRTS_OUT_DIR=data
# 只抓前 N 名，0 或留空表示全部 434 名
PRTS_LIMIT=0
# 是否下载头像与职业图标：1 开启 / 0 跳过
PRTS_MEDIA=1
# 导出人类可读视图到 <输出目录>/exports/：md / html / both / none
PRTS_EXPORT_FORMAT=both
